{
  "name": "daily-work-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "团队任务与标准日报：进度可视化与甘特图",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
