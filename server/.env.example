# Copy to .env (gitignored), then replace every <...> value.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://127.0.0.1:5183
DATABASE_URL=postgresql://<dev-user>:<url-encoded-password>@127.0.0.1:5432/<dev-database>
TEST_DATABASE_URL=postgresql://<test-user>:<url-encoded-password>@127.0.0.1:5432/dwa_test
# Optional independent DDL connection; never injected into the running production API.
# MIGRATION_DATABASE_URL=postgresql://<migrator>:<password>@<host>:5432/<database>
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<independent-random-secret-at-least-32-characters>
OTP_PEPPER=<independent-random-secret-at-least-32-characters>
RATE_LIMIT_HMAC_SECRET=<independent-random-secret-at-least-32-characters>
EMAIL_PROVIDER=console
SMS_PROVIDER=console
LOG_LEVEL=info
# Only set behind a controlled proxy; never trust arbitrary forwarded headers.
# TRUST_PROXY_CIDR=<controlled-proxy-CIDR>
# Tencent production values are documented in ../deploy/.env.example.
