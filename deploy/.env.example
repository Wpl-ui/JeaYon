# Copy to deploy/.env; chmod 600. Never commit or pass this file to a frontend build.
# Compose explicitly passes only runtime values into api, not bootstrap/migrator passwords.
POSTGRES_PASSWORD=<independent-random-bootstrap-password>
MIGRATOR_PASSWORD=<independent-random-migrator-password>
API_DB_PASSWORD=<independent-random-api-password>
BACKUP_DB_PASSWORD=<independent-random-backup-password>
# URL-encode passwords; match the corresponding password above. Host is the Compose service.
DATABASE_URL=postgresql://dwa_api:<url-encoded-api-password>@postgres:5432/dwa
MIGRATION_DATABASE_URL=postgresql://dwa_migrator:<url-encoded-migrator-password>@postgres:5432/dwa
# Each must be a different cryptographically random value, at least 32 characters (32 random bytes recommended).
JWT_SECRET=<independent-random-jwt-secret>
OTP_PEPPER=<independent-random-otp-pepper>
RATE_LIMIT_HMAC_SECRET=<independent-random-quota-key>
# Tencent CAM console -> dedicated subaccount -> API keys. Grant only SES SendEmail / SMS SendSms.
TENCENT_SECRET_ID=<CAM-subaccount-SecretId>
TENCENT_SECRET_KEY=<CAM-subaccount-SecretKey>
# Tencent SES console: verified sending domain and sender, approved template ID.
# Approved template variables must be named code and expiresMinutes (string values).
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=<verified-sender-email>
TENCENT_SES_TEMPLATE_ID=<approved-numeric-SES-template-ID>
TENCENT_SES_SUBJECT=<OTP-email-subject>
# Tencent SMS console -> applications -> SDKAppID; signature and body-template review pages.
# Approved template must take exactly two params, in order: code, validity in minutes.
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=<numeric-SMS-application-ID>
TENCENT_SMS_SIGN_NAME=<approved-SMS-sign-name>
TENCENT_SMS_TEMPLATE_ID=<approved-numeric-SMS-template-ID>
OTP_EMAIL_DAILY_CAP=1000
OTP_SMS_DAILY_CAP=500
# Backup uses native PostgreSQL 16 tools and libpq PG* env / PGPASSFILE; no password in argv.
# PGHOST=<private-DB-host>
# PGPORT=5432
# PGDATABASE=dwa
# PGUSER=dwa_backup
# PGPASSFILE=<absolute-path-to-mode-0600-pgpass>
# BACKUP_DIR=<absolute-restricted-backup-directory>
# RETENTION_DAYS=7
# BACKUP_UPLOAD_HOOK=<absolute-executable-encrypted-upload-and-verification-hook>
